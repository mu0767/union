{
  "private": true,
  "type": "module",
  "devDependencies": {
    "cpsat-js": "1.3.0",
    "esbuild": "0.25.9",
    "playwright": "1.55.0",
    "wrangler": "^4.0.0"
  },
  "scripts": {
    "build:cpsat": "node build-cpsat.mjs",
    "build:characters": "node build-character-catalog.mjs",
    "build:cloudflare": "node build-cloudflare.mjs",
    "dev:cloudflare": "wrangler dev",
    "deploy:cloudflare": "wrangler deploy",
    "db:local": "wrangler d1 execute union-db --local --file=worker/schema.sql",
    "db:remote": "wrangler d1 execute union-db --remote --file=worker/schema.sql",
    "test:shared": "node --test verify-shared-state.mjs"
  }
}
